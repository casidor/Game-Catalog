<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Game_Catalog.ViewModels"
			 xmlns:models="using:Game_Catalog.Models"
			 xmlns:conv="using:Game_Catalog.Converters"
			 xmlns:val="using:Game_Catalog.Validation"
			 xmlns:v="using:Game_Catalog.Views"
			 x:Class="Game_Catalog.Views.GamesListView"
			 x:DataType="vm:GamesListViewModel">

	<UserControl.Styles>
		<!-- Card items: only the card itself, without the list item visuals of the theme -->
		<Style Selector="ListBox.cards ListBoxItem">
			<Setter Property="Margin" Value="0,0,12,12"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="ClipToBounds" Value="False"/>
			<Setter Property="RenderTransform" Value="scale(1)"/>
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
			<Setter Property="Template">
				<ControlTemplate>
					<ContentPresenter Name="PART_ContentPresenter"
									  ClipToBounds="False"
									  Background="Transparent"
									  Content="{TemplateBinding Content}"
									  ContentTemplate="{TemplateBinding ContentTemplate}"/>
				</ControlTemplate>
			</Setter>
		</Style>

		<!-- The card under the pointer grows over its neighbours: it is scaled as a whole and drawn above them -->
		<Style Selector="ListBox.cards ListBoxItem:pointerover">
			<Setter Property="RenderTransform" Value="scale(1.05)"/>
			<Setter Property="ZIndex" Value="1"/>
		</Style>

		<!-- Game card frame: visible only on the selected cards -->
		<Style Selector="Border.gameCard">
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="ListBox.cards ListBoxItem:selected Border.gameCard">
			<Setter Property="BorderBrush" Value="{DynamicResource NavForeground}"/>
		</Style>

		<!-- Selection checkbox of a card: shown on hover and on the selected cards -->
		<Style Selector="ListBox.cards ListBoxItem Border.pick">
			<Setter Property="IsVisible" Value="False"/>
		</Style>
		<Style Selector="ListBox.cards ListBoxItem:pointerover Border.pick">
			<Setter Property="IsVisible" Value="True"/>
		</Style>
		<Style Selector="ListBox.cards ListBoxItem:selected Border.pick">
			<Setter Property="IsVisible" Value="True"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">

		<!-- Toolbar -->
		<Border Grid.Row="0" Padding="16,12" Margin="{StaticResource CaptionButtonsInset}">
			<Grid ColumnDefinitions="Auto,*">
				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<TextBlock Text="{Binding PageTitle}"
							   FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
					<Button Content="+" ToolTip.Tip="Додати гру"
							Width="32" Padding="0" FontSize="18"
							Command="{Binding AddCommand}"
							IsVisible="{Binding CanAdd}"
							VerticalAlignment="Center"/>
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
							HorizontalAlignment="Right" VerticalAlignment="Center">
					<TextBlock Text="{Binding SearchSummary}"
							   IsVisible="{Binding SearchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							   FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
					<TextBox Text="{Binding SearchText}"
							 PlaceholderText="🔍 Пошук гри..."
							 Width="220" VerticalAlignment="Center"/>

					<!-- Sort menu -->
					<DropDownButton Content="⇅ Сортування" VerticalAlignment="Center">
						<DropDownButton.Flyout>
							<MenuFlyout Placement="BottomEdgeAlignedRight">
								<MenuItem Header="Назва" ToggleType="Radio" GroupName="SortField"
										  Command="{Binding SetSortFieldCommand}"
										  CommandParameter="{x:Static models:GameSortField.Title}"
										  IsChecked="{Binding SortField, Mode=OneWay, Converter={x:Static conv:EqualsParameterConverter.Instance}, ConverterParameter={x:Static models:GameSortField.Title}}"/>
								<MenuItem Header="Рік випуску" ToggleType="Radio" GroupName="SortField"
										  Command="{Binding SetSortFieldCommand}"
										  CommandParameter="{x:Static models:GameSortField.Year}"
										  IsChecked="{Binding SortField, Mode=OneWay, Converter={x:Static conv:EqualsParameterConverter.Instance}, ConverterParameter={x:Static models:GameSortField.Year}}"/>
								<MenuItem Header="Оцінка" ToggleType="Radio" GroupName="SortField"
										  Command="{Binding SetSortFieldCommand}"
										  CommandParameter="{x:Static models:GameSortField.Rating}"
										  IsChecked="{Binding SortField, Mode=OneWay, Converter={x:Static conv:EqualsParameterConverter.Instance}, ConverterParameter={x:Static models:GameSortField.Rating}}"/>
								<MenuItem Header="Розмір на диску" ToggleType="Radio" GroupName="SortField"
										  Command="{Binding SetSortFieldCommand}"
										  CommandParameter="{x:Static models:GameSortField.Size}"
										  IsChecked="{Binding SortField, Mode=OneWay, Converter={x:Static conv:EqualsParameterConverter.Instance}, ConverterParameter={x:Static models:GameSortField.Size}}"/>
								<MenuItem Header="Час гри" ToggleType="Radio" GroupName="SortField"
										  Command="{Binding SetSortFieldCommand}"
										  CommandParameter="{x:Static models:GameSortField.Hours}"
										  IsChecked="{Binding SortField, Mode=OneWay, Converter={x:Static conv:EqualsParameterConverter.Instance}, ConverterParameter={x:Static models:GameSortField.Hours}}"/>
								<Separator/>
								<MenuItem Header="За зростанням" ToggleType="Radio" GroupName="SortDirection"
										  Command="{Binding SetAscendingCommand}"
										  IsChecked="{Binding !SortDescending, Mode=OneWay}"/>
								<MenuItem Header="За спаданням" ToggleType="Radio" GroupName="SortDirection"
										  Command="{Binding SetDescendingCommand}"
										  IsChecked="{Binding SortDescending, Mode=OneWay}"/>
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>

					<DropDownButton Content="{Binding ViewModeIcon}" ToolTip.Tip="Вигляд: сітка або список"
									VerticalAlignment="Center">
						<DropDownButton.Flyout>
							<MenuFlyout Placement="BottomEdgeAlignedRight">
								<MenuItem Header="Сітка" ToggleType="Radio" GroupName="ViewMode"
										  Command="{Binding SetGridViewCommand}"
										  IsChecked="{Binding IsGridView, Mode=OneWay}"/>
								<MenuItem Header="Список" ToggleType="Radio" GroupName="ViewMode"
										  Command="{Binding SetListViewCommand}"
										  IsChecked="{Binding !IsGridView, Mode=OneWay}"/>
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
					<Button Content="◨"
							ToolTip.Tip="Показати або приховати панель перегляду"
							Command="{Binding TogglePreviewCommand}"
							VerticalAlignment="Center"/>
					<Button Content="{Binding FiltersButtonText}"
							Command="{Binding OpenFiltersCommand}"
							VerticalAlignment="Center"/>
					<Button Content="✕ Скинути"
							Command="{Binding ResetFiltersCommand}"
							IsVisible="{Binding HasActiveFilter}"
							VerticalAlignment="Center"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Content: the list on the left, the preview panel on the right -->
		<Grid Grid.Row="1" ColumnDefinitions="*,Auto">

			<!-- Grid view: several cards can be selected with Ctrl and Shift or with the checkbox of a card -->
			<ScrollViewer IsVisible="{Binding ShowGrid}">
				<ListBox Classes="cards"
						 ItemsSource="{Binding Rows}"
						 SelectionMode="Multiple"
						 SelectedItems="{Binding SelectedRows}"
						 Background="Transparent"
						 DoubleTapped="OnCardDoubleTapped">
					<ListBox.KeyBindings>
						<KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}"/>
						<KeyBinding Gesture="Escape" Command="{Binding ClearSelectionCommand}"/>
					</ListBox.KeyBindings>

					<!-- Same actions as the table menu -->
					<ListBox.ContextMenu>
						<ContextMenu>
							<MenuItem Header="{Binding ArchiveSelectedHeader}"
									  Command="{Binding ArchiveSelectedCommand}"
									  IsVisible="{Binding !IsArchive}"/>
							<MenuItem Header="{Binding RestoreSelectedHeader}"
									  Command="{Binding RestoreSelectedCommand}"
									  IsVisible="{Binding IsArchive}"/>
							<Separator/>
							<MenuItem Header="Редагувати"
									  Command="{Binding EditSelectedCommand}"/>
							<Separator/>
							<MenuItem Header="{Binding DeleteSelectedHeader}"
									  Command="{Binding DeleteSelectedCommand}"
									  InputGesture="Delete"/>
						</ContextMenu>
					</ListBox.ContextMenu>

					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" Margin="16"/>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:GameRow">
							<Border Classes="gameCard"
									Width="160" Height="245" CornerRadius="8" ClipToBounds="True"
									Background="{DynamicResource CardBackground}">
								<Grid RowDefinitions="*,Auto">
									<Panel Grid.Row="0">
										<Image Width="160" Height="215" Stretch="UniformToFill"
											   Source="{Binding CoverImagePath, Converter={x:Static conv:PathToBitmapConverter.Instance}, ConverterParameter=640}"
											   IsVisible="{Binding CoverImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
										<!-- Quiet placeholder: marks a missing cover without drawing attention -->
										<TextBlock Text="🎮" FontSize="32" Opacity="0.25"
												   HorizontalAlignment="Center" VerticalAlignment="Center"
												   IsVisible="{Binding CoverImagePath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
										<!-- Adds the card to the selection or takes it out, keeping the other cards selected -->
										<Border Classes="pick"
												HorizontalAlignment="Left" VerticalAlignment="Top"
												Margin="6" Padding="4,0" CornerRadius="4"
												Background="#99000000">
											<CheckBox MinWidth="0" Padding="0"
													  ToolTip.Tip="Вибрати"
													  IsChecked="{Binding $parent[ListBoxItem].IsSelected}"/>
										</Border>
									</Panel>
									<Border Grid.Row="1" Padding="8,6"
											Background="{Binding IsMatch, Converter={x:Static conv:SearchMatchBrushConverter.Instance}}">
										<TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
												   TextWrapping="Wrap" MaxLines="2"
												   TextTrimming="CharacterEllipsis"/>
									</Border>
								</Grid>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</ScrollViewer>

			<!-- Table view -->
			<DataGrid ItemsSource="{Binding Rows}"
					  Classes="table searchable dbSort"
					  IsVisible="{Binding ShowList}"
					  CanUserSortColumns="True"
					  SelectionMode="Extended"
					  v:DataGridBehavior.SelectedItems="{Binding SelectedRows}"
					  v:DataGridBehavior.RowDoubleTapCommand="{Binding OpenGameCommand}"
					  v:DataGridBehavior.DeleteCommand="{Binding DeleteSelectedCommand}"
					  x:Name="GamesGrid">

				<!-- Archive on the library page, restore on the archive page -->
				<DataGrid.ContextMenu>
					<ContextMenu>
						<MenuItem Header="{Binding ArchiveSelectedHeader}"
								  Command="{Binding ArchiveSelectedCommand}"
								  IsVisible="{Binding !IsArchive}"/>
						<MenuItem Header="{Binding RestoreSelectedHeader}"
								  Command="{Binding RestoreSelectedCommand}"
								  IsVisible="{Binding IsArchive}"/>
						<Separator/>
						<MenuItem Header="Редагувати"
								  Command="{Binding EditSelectedCommand}"/>
						<Separator/>
						<MenuItem Header="{Binding DeleteSelectedHeader}"
								  Command="{Binding DeleteSelectedCommand}"
								  InputGesture="Delete"/>
					</ContextMenu>
				</DataGrid.ContextMenu>

				<DataGrid.Columns>
					<DataGridTextColumn Header="Назва" Width="2*" Binding="{ReflectionBinding Title}"
										Tag="{x:Static models:GameSortField.Title}"/>
					<DataGridTextColumn Header="Студія" Width="*" Binding="{ReflectionBinding DeveloperName}"
										CanUserSort="False"/>
					<DataGridTextColumn Header="Жанри" Width="*" Binding="{ReflectionBinding GenresText, TargetNullValue={StaticResource NoValue}}"
										CanUserSort="False"/>
					<DataGridTextColumn Header="Платформи" Width="*" Binding="{ReflectionBinding PlatformsText, TargetNullValue={StaticResource NoValue}}"
										CanUserSort="False"/>
					<DataGridTextColumn Header="Рік" Width="80" Binding="{ReflectionBinding YearText, TargetNullValue={StaticResource NoValue}}"
										Tag="{x:Static models:GameSortField.Year}"/>
					<DataGridTextColumn Header="Статус" Width="110"
										Binding="{ReflectionBinding Status, Mode=OneWay, Converter={x:Static conv:GameStatusConverter.Instance}}"
										CanUserSort="False"/>
					<DataGridTextColumn Header="Оцінка" Width="80" Binding="{ReflectionBinding RatingText, TargetNullValue={StaticResource NoValue}}"
										Tag="{x:Static models:GameSortField.Rating}"/>
					<DataGridTextColumn Header="Час гри" Width="110"
										Binding="{ReflectionBinding TotalHours, Mode=OneWay, Converter={x:Static conv:DurationConverter.Instance}}"
										Tag="{x:Static models:GameSortField.Hours}"/>
					<DataGridTextColumn Header="Розмір" Width="110" Binding="{ReflectionBinding SizeText, TargetNullValue={StaticResource NoValue}}"
										Tag="{x:Static models:GameSortField.Size}"/>
				</DataGrid.Columns>
			</DataGrid>

			<!-- Preview panel: a compact version of the game page for the selected game -->
			<Border Grid.Column="1" Width="300" IsVisible="{Binding IsPreviewOpen}"
					Background="{DynamicResource SidebarBackground}"
					BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="1,0,0,0">
				<Panel>
					<TextBlock Text="Оберіть гру, щоб побачити її дані" Opacity="0.5"
							   TextWrapping="Wrap" TextAlignment="Center" Margin="24"
							   HorizontalAlignment="Center" VerticalAlignment="Center"
							   IsVisible="{Binding !HasSelection}"/>

					<ScrollViewer IsVisible="{Binding HasSelection}">
						<StackPanel Margin="16" Spacing="8">
							<Border Width="180" Height="240" CornerRadius="8" ClipToBounds="True"
									HorizontalAlignment="Center"
									Background="{DynamicResource CardBackground}">
								<Panel>
									<Image Stretch="UniformToFill"
										   Source="{Binding SelectedRow.CoverImagePath, Converter={x:Static conv:PathToBitmapConverter.Instance}, ConverterParameter=640}"
										   IsVisible="{Binding SelectedRow.CoverImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
									<TextBlock Text="🎮" FontSize="48"
											   HorizontalAlignment="Center" VerticalAlignment="Center"
											   IsVisible="{Binding SelectedRow.CoverImagePath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
								</Panel>
							</Border>

							<TextBlock Text="{Binding SelectedRow.Title}" FontSize="16" FontWeight="SemiBold"
									   TextWrapping="Wrap" Margin="0,4,0,0"/>
							<Border Height="1" Background="{DynamicResource SidebarBorder}"/>

							<Grid ColumnDefinitions="110,*">
								<TextBlock Grid.Column="0" Text="Студія" Opacity="0.6"/>
								<TextBlock Grid.Column="1" Text="{Binding SelectedRow.DeveloperName}" TextWrapping="Wrap"/>
							</Grid>
							<Grid ColumnDefinitions="110,*">
								<TextBlock Grid.Column="0" Text="Жанри" Opacity="0.6"/>
								<TextBlock Grid.Column="1" Text="{Binding SelectedRow.GenresText, TargetNullValue={StaticResource NoValue}}" TextWrapping="Wrap"/>
							</Grid>
							<Grid ColumnDefinitions="110,*">
								<TextBlock Grid.Column="0" Text="Статус" Opacity="0.6"/>
								<TextBlock Grid.Column="1" Text="{Binding SelectedRow.Status, Converter={x:Static conv:GameStatusConverter.Instance}}" TextWrapping="Wrap"/>
							</Grid>
							<Grid ColumnDefinitions="110,*">
								<TextBlock Grid.Column="0" Text="Рік випуску" Opacity="0.6"/>
								<TextBlock Grid.Column="1" Text="{Binding SelectedRow.YearText, TargetNullValue={StaticResource NoValue}}" TextWrapping="Wrap"/>
							</Grid>
							<Grid ColumnDefinitions="110,*">
								<TextBlock Grid.Column="0" Text="Оцінка" Opacity="0.6"/>
								<TextBlock Grid.Column="1" Text="{Binding SelectedRow.RatingText, TargetNullValue={StaticResource NoValue}}" TextWrapping="Wrap"/>
							</Grid>
							<Grid ColumnDefinitions="110,*">
								<TextBlock Grid.Column="0" Text="Час гри" Opacity="0.6"/>
								<TextBlock Grid.Column="1" Text="{Binding SelectedRow.TotalHours, Converter={x:Static conv:DurationConverter.Instance}}" TextWrapping="Wrap"/>
							</Grid>
							<Grid ColumnDefinitions="110,*">
								<TextBlock Grid.Column="0" Text="Розмір" Opacity="0.6"/>
								<TextBlock Grid.Column="1" Text="{Binding SelectedRow.SizeText, TargetNullValue={StaticResource NoValue}}" TextWrapping="Wrap"/>
							</Grid>

							<TextBlock Text="Платформи" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
							<Border Height="1" Background="{DynamicResource SidebarBorder}"/>
							<ItemsControl ItemsSource="{Binding SelectedRow.Platforms}"
										  IsVisible="{Binding SelectedRow.HasPlatforms}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="models:Platform">
										<Border CornerRadius="12" Padding="10,3" Margin="0,0,6,6"
												Background="#30808080">
											<TextBlock Text="{Binding PlatformName}"
													   FontSize="12" FontWeight="SemiBold"/>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock Text="Платформ немає" Opacity="0.5"
									   IsVisible="{Binding !SelectedRow.HasPlatforms}"/>

							<TextBlock Text="Теги" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
							<Border Height="1" Background="{DynamicResource SidebarBorder}"/>
							<ItemsControl ItemsSource="{Binding SelectedRow.Tags}"
										  IsVisible="{Binding SelectedRow.HasTags}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="models:Tag">
										<Border CornerRadius="12" Padding="10,3" Margin="0,0,6,6"
												Background="{Binding Color, Converter={x:Static conv:TagBadgeBrushConverter.Instance}, ConverterParameter=Background}">
											<TextBlock Text="{Binding TagName}"
													   FontSize="12" FontWeight="SemiBold"
													   Foreground="{Binding Color, Converter={x:Static conv:TagBadgeBrushConverter.Instance}, ConverterParameter=Foreground}"/>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock Text="Тегів немає" Opacity="0.5"
									   IsVisible="{Binding !SelectedRow.HasTags}"/>

							<Button Content="✏ Редагувати" Margin="0,12,0,0"
									HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
									Command="{Binding EditCommand}"
									CommandParameter="{Binding SelectedRow.Game}"/>
						</StackPanel>
					</ScrollViewer>
				</Panel>
			</Border>

			<!-- Empty state -->
			<StackPanel IsVisible="{Binding IsEmpty}"
						HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
				<TextBlock Text="🎮" FontSize="48" HorizontalAlignment="Center"/>
				<TextBlock Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
				<Button Content="+ Додати гру"
						Command="{Binding AddCommand}"
						IsVisible="{Binding ShowAddInEmpty}"
						HorizontalAlignment="Center"
						Padding="24,10" FontSize="14"/>
				<TextBlock Text="{Binding EmptyHint}" Opacity="0.6" HorizontalAlignment="Center"/>
			</StackPanel>

			<!-- Filtered empty state -->
			<StackPanel IsVisible="{Binding IsFilteredEmpty}"
						HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
				<TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center"/>
				<TextBlock Text="Ігор не знайдено" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
				<TextBlock Text="Спробуйте змінити фільтр" Opacity="0.6" HorizontalAlignment="Center"/>
			</StackPanel>
		</Grid>

		<!-- Filter side panel with a dimmed, click-blocking backdrop -->
		<Grid Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsFilterPanelOpen}">
			<Border Background="{DynamicResource OverlayScrim}" PointerPressed="OnOverlayPressed"/>
			<Border Classes="filterPanel">
				<Grid RowDefinitions="Auto,*,Auto">

					<Border Grid.Row="0" Padding="12,12"
							BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,0,1">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<Button Grid.Column="0" Content="✕"
									Command="{Binding CancelFiltersCommand}"
									Background="Transparent" Padding="10,4"/>
							<TextBlock Grid.Column="1" Text="Фільтри"
									   FontSize="18" FontWeight="Bold"
									   Margin="12,0" VerticalAlignment="Center"/>
							<Button Grid.Column="2" Content="Скинути"
									Command="{Binding ClearDraftCommand}"
									Background="Transparent" Padding="10,4"/>
						</Grid>
					</Border>

					<ScrollViewer Grid.Row="1">
						<StackPanel>

							<StackPanel Spacing="8" Margin="20,16">
								<TextBlock Text="Статус" FontSize="15" FontWeight="SemiBold"/>
								<ItemsControl ItemsSource="{Binding StatusOptions}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:FilterOption">
											<CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
							<Border Height="1" Background="{DynamicResource SidebarBorder}"/>

							<StackPanel Spacing="8" Margin="20,16">
								<TextBlock Text="Жанр" FontSize="15" FontWeight="SemiBold"/>
								<ItemsControl ItemsSource="{Binding GenreOptions}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:FilterOption">
											<CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
							<Border Height="1" Background="{DynamicResource SidebarBorder}"/>

							<StackPanel Spacing="8" Margin="20,16">
								<TextBlock Text="Платформа" FontSize="15" FontWeight="SemiBold"/>
								<ItemsControl ItemsSource="{Binding PlatformOptions}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:FilterOption">
											<CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
							<Border Height="1" Background="{DynamicResource SidebarBorder}"/>

							<StackPanel Spacing="8" Margin="20,16">
								<TextBlock Text="Тег" FontSize="15" FontWeight="SemiBold"/>
								<ItemsControl ItemsSource="{Binding TagOptions}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:FilterOption">
											<CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
							<Border Height="1" Background="{DynamicResource SidebarBorder}"/>

							<StackPanel Spacing="8" Margin="20,16">
								<TextBlock Text="Студія" FontSize="15" FontWeight="SemiBold"/>
								<ItemsControl ItemsSource="{Binding DeveloperOptions}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:FilterOption">
											<CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
							<Border Height="1" Background="{DynamicResource SidebarBorder}"/>

							<StackPanel Spacing="8" Margin="20,16">
								<TextBlock Text="Рік випуску" FontSize="15" FontWeight="SemiBold"/>
								<Grid ColumnDefinitions="Auto,8,*,16,Auto,8,*">
									<TextBlock Grid.Column="0" Text="від" VerticalAlignment="Center"/>
									<v:SpinBoundedNumericUpDown Grid.Column="2" FormatString="0" Minimum="{x:Static val:YearLimits.ReleaseYearMinimum}" Maximum="{x:Static val:YearLimits.ReleaseYearMaximum}"
															SpinMinimum="{x:Static val:YearLimits.ReleaseYearMinimum}" SpinMaximum="{x:Static val:YearLimits.ReleaseYearMaximum}"
															SpinStart="{x:Static val:YearLimits.CurrentYear}" ShowButtonSpinner="False"
															Value="{Binding DraftYearFrom, Converter={x:Static conv:DecimalToNullableIntConverter.Instance}}"/>
									<TextBlock Grid.Column="4" Text="до" VerticalAlignment="Center"/>
									<v:SpinBoundedNumericUpDown Grid.Column="6" FormatString="0" Minimum="{x:Static val:YearLimits.ReleaseYearMinimum}" Maximum="{x:Static val:YearLimits.ReleaseYearMaximum}"
															SpinMinimum="{x:Static val:YearLimits.ReleaseYearMinimum}" SpinMaximum="{x:Static val:YearLimits.ReleaseYearMaximum}"
															SpinStart="{x:Static val:YearLimits.CurrentYear}" ShowButtonSpinner="False"
															Value="{Binding DraftYearTo, Converter={x:Static conv:DecimalToNullableIntConverter.Instance}}"/>
								</Grid>
							</StackPanel>
							<Border Height="1" Background="{DynamicResource SidebarBorder}"/>

							<StackPanel Spacing="8" Margin="20,16">
								<TextBlock Text="Особиста оцінка" FontSize="15" FontWeight="SemiBold"/>
								<Grid ColumnDefinitions="Auto,8,*,16,Auto,8,*">
									<TextBlock Grid.Column="0" Text="від" VerticalAlignment="Center"/>
									<v:SpinBoundedNumericUpDown Grid.Column="2" FormatString="0" Minimum="1" Maximum="10" SpinMinimum="1" SpinMaximum="10"
															Value="{Binding DraftRatingFrom, Converter={x:Static conv:DecimalToNullableIntConverter.Instance}}"/>
									<TextBlock Grid.Column="4" Text="до" VerticalAlignment="Center"/>
									<v:SpinBoundedNumericUpDown Grid.Column="6" FormatString="0" Minimum="1" Maximum="10" SpinMinimum="1" SpinMaximum="10"
															Value="{Binding DraftRatingTo, Converter={x:Static conv:DecimalToNullableIntConverter.Instance}}"/>
								</Grid>
							</StackPanel>
							<Border Height="1" Background="{DynamicResource SidebarBorder}"/>

							<StackPanel Spacing="8" Margin="20,16">
								<TextBlock Text="Розмір на диску (ГБ)" FontSize="15" FontWeight="SemiBold"/>
								<Grid ColumnDefinitions="Auto,8,*,16,Auto,8,*">
									<TextBlock Grid.Column="0" Text="від" VerticalAlignment="Center"/>
									<v:SpinBoundedNumericUpDown Grid.Column="2" FormatString="0.##" Minimum="0" Maximum="10000" Increment="0.5"
															SpinMinimum="0" SpinMaximum="10000" AllowsFraction="True" ShowButtonSpinner="False"
															Value="{Binding DraftSizeFrom, Converter={x:Static conv:DecimalToNullableDoubleConverter.Instance}}"/>
									<TextBlock Grid.Column="4" Text="до" VerticalAlignment="Center"/>
									<v:SpinBoundedNumericUpDown Grid.Column="6" FormatString="0.##" Minimum="0" Maximum="10000" Increment="0.5"
															SpinMinimum="0" SpinMaximum="10000" AllowsFraction="True" ShowButtonSpinner="False"
															Value="{Binding DraftSizeTo, Converter={x:Static conv:DecimalToNullableDoubleConverter.Instance}}"/>
								</Grid>
							</StackPanel>
							<Border Height="1" Background="{DynamicResource SidebarBorder}"/>

							<StackPanel Spacing="8" Margin="20,16">
								<TextBlock Text="Час гри (год)" FontSize="15" FontWeight="SemiBold"/>
								<Grid ColumnDefinitions="Auto,8,*,16,Auto,8,*">
									<TextBlock Grid.Column="0" Text="від" VerticalAlignment="Center"/>
									<v:SpinBoundedNumericUpDown Grid.Column="2" FormatString="0.##" Minimum="0" Maximum="100000" Increment="1"
															SpinMinimum="0" SpinMaximum="100000" AllowsFraction="True" ShowButtonSpinner="False"
															Value="{Binding DraftHoursFrom, Converter={x:Static conv:DecimalToNullableDoubleConverter.Instance}}"/>
									<TextBlock Grid.Column="4" Text="до" VerticalAlignment="Center"/>
									<v:SpinBoundedNumericUpDown Grid.Column="6" FormatString="0.##" Minimum="0" Maximum="100000" Increment="1"
															SpinMinimum="0" SpinMaximum="100000" AllowsFraction="True" ShowButtonSpinner="False"
															Value="{Binding DraftHoursTo, Converter={x:Static conv:DecimalToNullableDoubleConverter.Instance}}"/>
								</Grid>
							</StackPanel>

						</StackPanel>
					</ScrollViewer>

					<Border Grid.Row="2" Padding="20,12"
							BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,1,0,0">
						<Button Content="Застосувати"
								Command="{Binding ApplyFiltersCommand}"
								HorizontalAlignment="Stretch"
								Padding="0,10"/>
					</Border>

				</Grid>
			</Border>
		</Grid>

	</Grid>
</UserControl>