<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Game_Catalog.ViewModels"
			 xmlns:models="using:Game_Catalog.Models"
			 xmlns:conv="using:Game_Catalog.Converters"
			 x:Class="Game_Catalog.Views.TagsTabView"
			 x:DataType="vm:TagsViewModel">

	<Grid RowDefinitions="Auto,Auto,*">

		<!-- Toolbar -->
		<Border Grid.Row="0" Padding="16,12">
			<Grid ColumnDefinitions="Auto,*">
				<Button Grid.Column="0" Content="+ Додати тег"
						Command="{Binding AddCommand}"/>
				<TextBox Grid.Column="1" Text="{Binding SearchText}"
						 PlaceholderText="🔍 Пошук тегу..."
						 Width="200" HorizontalAlignment="Right"/>
			</Grid>
		</Border>

		<!-- Table header -->
		<Border Grid.Row="1" Padding="16,8"
				BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,0,1">
			<Grid ColumnDefinitions="*,80">
				<TextBlock Grid.Column="0" Text="Назва" FontSize="12" Opacity="0.5"/>
			</Grid>
		</Border>

		<!-- Tags list -->
		<ScrollViewer Grid.Row="2">
			<ItemsControl ItemsSource="{Binding Items}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="models:Tag">
						<Border Padding="16,8"
								BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,0,1">
							<Grid ColumnDefinitions="*,80">
								<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
											VerticalAlignment="Center">
									<Ellipse Width="14" Height="14"
											 Fill="{Binding Color, Converter={x:Static conv:TagColorConverter.Instance}}"
											 Stroke="{DynamicResource NavForeground}"
											 StrokeThickness="1"/>
									<TextBlock Text="{Binding TagName}" FontWeight="SemiBold"/>
								</StackPanel>
								<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
									<Button Content="✏" ToolTip.Tip="Редагувати"
											Command="{Binding $parent[ItemsControl].((vm:TagsViewModel)DataContext).EditCommand}"
											CommandParameter="{Binding}"/>
									<Button Content="🗑" ToolTip.Tip="Видалити"
											Command="{Binding $parent[ItemsControl].((vm:TagsViewModel)DataContext).DeleteCommand}"
											CommandParameter="{Binding}"/>
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<!-- Empty state -->
		<StackPanel Grid.Row="2" IsVisible="{Binding IsEmpty}"
					HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
			<TextBlock Text="🔖" FontSize="48" HorizontalAlignment="Center"/>
			<TextBlock Text="Тегів немає" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
			<TextBlock Text="Додайте перший тег" Opacity="0.6" HorizontalAlignment="Center"/>
		</StackPanel>

		<!-- Filtered empty state -->
		<StackPanel Grid.Row="2" IsVisible="{Binding IsFilteredEmpty}"
					HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
			<TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center"/>
			<TextBlock Text="Тегів не знайдено" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
			<TextBlock Text="Спробуйте змінити критерії пошуку" Opacity="0.6" HorizontalAlignment="Center"/>
		</StackPanel>

	</Grid>
</UserControl>