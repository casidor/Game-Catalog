<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Game_Catalog.ViewModels"
			 xmlns:conv="using:Game_Catalog.Converters"
			 xmlns:views="using:Game_Catalog.Views"
			 x:Class="Game_Catalog.Views.StatisticsView"
			 x:DataType="vm:StatisticsViewModel">

	<UserControl.Styles>
		<!-- Summary card of the overview column -->
		<Style Selector="Border.statCard">
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="16,14"/>
		</Style>
		<Style Selector="TextBlock.statCaption">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Opacity" Value="0.6"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBlock.statValue">
			<Setter Property="FontSize" Value="22"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>

		<!-- Clickable card: looks like a summary card, opens the game on click -->
		<Style Selector="Button.statCard">
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="16,14"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		</Style>
		<Style Selector="Button.statCard:pressed">
			<Setter Property="RenderTransform" Value="none"/>
		</Style>

		<!-- Statistic tables: fixed order from the query, read-only -->
		<Style Selector="DataGrid.statTable">
			<Setter Property="AutoGenerateColumns" Value="False"/>
			<Setter Property="IsReadOnly" Value="True"/>
			<Setter Property="CanUserSortColumns" Value="False"/>
			<Setter Property="CanUserResizeColumns" Value="True"/>
			<Setter Property="CanUserReorderColumns" Value="False"/>
			<Setter Property="GridLinesVisibility" Value="None"/>
			<Setter Property="HeadersVisibility" Value="Column"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="RowHeight" Value="44"/>
			<Setter Property="SelectionMode" Value="Single"/>
		</Style>
		<Style Selector="DataGrid.statTable DataGridColumnHeader">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">

		<!-- Top bar: title on the left, tabs on the right -->
		<Border Grid.Row="0" Padding="16,12" Margin="{StaticResource CaptionButtonsInset}">
			<Grid ColumnDefinitions="*,Auto">
				<TextBlock Grid.Column="0" Text="Статистика"
						   FontSize="20" FontWeight="Bold"
						   VerticalAlignment="Center"/>
				<TabStrip Grid.Column="1" VerticalAlignment="Center"
						  SelectedIndex="{Binding SelectedTabIndex}">
					<TabStrip.Styles>
						<Style Selector="TabStripItem">
							<Setter Property="FontSize" Value="16"/>
							<Setter Property="MinHeight" Value="40"/>
						</Style>
					</TabStrip.Styles>
					<TabStripItem Content="Огляд"/>
					<TabStripItem Content="Студії"/>
					<TabStripItem Content="Жанри"/>
					<TabStripItem Content="Активність"/>
				</TabStrip>
			</Grid>
		</Border>

		<!-- Overview tab: summary cards on the left, the play time table on the right -->
		<Grid Grid.Row="1" ColumnDefinitions="280,*"
			  IsVisible="{Binding IsOverviewTab}">

			<ScrollViewer Grid.Column="0">
				<StackPanel Spacing="10" Margin="16,0,16,16">

					<Border Classes="statCard">
						<StackPanel Spacing="6">
							<TextBlock Classes="statCaption" Text="🎮  Ігор у бібліотеці"/>
							<TextBlock Classes="statValue" Text="{Binding GameCount}"/>
						</StackPanel>
					</Border>

					<Border Classes="statCard">
						<StackPanel Spacing="6">
							<TextBlock Classes="statCaption" Text="⏱  Загальний час"/>
							<TextBlock Classes="statValue"
									   Text="{Binding TotalHours, Converter={x:Static conv:DurationConverter.Instance}}"/>
						</StackPanel>
					</Border>

					<Border Classes="statCard">
						<StackPanel Spacing="6">
							<TextBlock Classes="statCaption" Text="💾  Обсяг на диску"/>
							<TextBlock Classes="statValue"
									   Text="{Binding SizeText, TargetNullValue={StaticResource NoValue}}"/>
						</StackPanel>
					</Border>

					<Border Classes="statCard">
						<StackPanel Spacing="6">
							<TextBlock Classes="statCaption" Text="⭐  Середня оцінка"/>
							<TextBlock Classes="statValue"
									   Text="{Binding RatingText, TargetNullValue={StaticResource NoValue}}"/>
						</StackPanel>
					</Border>

					<!-- Longest session: opens its game on click -->
					<Button Classes="statCard" Margin="0,2,0,0"
							Command="{Binding OpenLongestSessionGameCommand}"
							IsVisible="{Binding HasLongestSession}"
							ToolTip.Tip="Відкрити гру">
						<StackPanel Spacing="10">
							<TextBlock Classes="statCaption" Text="🏆  Найдовша сесія"/>
							<Grid ColumnDefinitions="Auto,*">
								<Border Grid.Column="0" Width="60" Height="80" CornerRadius="4"
										ClipToBounds="True"
										Background="{DynamicResource SidebarBackground}">
									<Panel>
										<TextBlock Text="🎮" FontSize="24" Opacity="0.5"
												   HorizontalAlignment="Center" VerticalAlignment="Center"/>
										<Image Source="{Binding LongestSession.CoverImagePath, Converter={x:Static conv:PathToBitmapConverter.Instance}, ConverterParameter=160}"
											   Stretch="UniformToFill"/>
									</Panel>
								</Border>
								<StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0"
											VerticalAlignment="Center">
									<TextBlock Text="{Binding LongestSession.DurationSeconds, Converter={x:Static conv:DurationConverter.Instance}}"
											   FontSize="18" FontWeight="SemiBold"/>
									<TextBlock Text="{Binding LongestSession.GameTitle}"
											   TextTrimming="CharacterEllipsis"/>
									<TextBlock Text="{Binding LongestStartText}"
											   FontSize="12" Opacity="0.6"/>
								</StackPanel>
							</Grid>
						</StackPanel>
					</Button>

					<!-- Longest session when there are no finished sessions -->
					<Border Classes="statCard" Margin="0,2,0,0"
							IsVisible="{Binding !HasLongestSession}">
						<StackPanel Spacing="6">
							<TextBlock Classes="statCaption" Text="🏆  Найдовша сесія"/>
							<TextBlock Classes="statValue" Text="{StaticResource NoValue}"/>
						</StackPanel>
					</Border>

				</StackPanel>
			</ScrollViewer>

			<!-- Games by play time -->
			<Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="0,0,16,16">
				<TextBlock Grid.Row="0" Text="Ігри за часом гри"
						   FontSize="14" FontWeight="SemiBold"
						   Margin="8,0,0,8"/>

				<!-- Order is fixed by the query: the most played game first -->
				<DataGrid Grid.Row="1" Classes="statTable"
						  ItemsSource="{Binding GamesByPlayTime}"
						  IsVisible="{Binding HasPlayTimeRows}"
						  views:DataGridBehavior.RowDoubleTapCommand="{Binding OpenPlayTimeGameCommand}">

					<DataGrid.Columns>
						<DataGridTextColumn Header="Гра" Width="*"
											Binding="{ReflectionBinding GameTitle, Mode=OneWay}"/>
						<DataGridTextColumn Header="Час" Width="140"
											Binding="{ReflectionBinding TotalHours, Mode=OneWay, Converter={x:Static conv:DurationConverter.Instance}}"/>
						<DataGridTextColumn Header="Частка" Width="100"
											Binding="{ReflectionBinding SharePercent, Mode=OneWay, StringFormat='{}{0:0.0} %'}"/>
					</DataGrid.Columns>
				</DataGrid>

				<!-- Empty state -->
				<TextBlock Grid.Row="1"
						   IsVisible="{Binding !HasPlayTimeRows}"
						   Text="Ще немає завершених сесій"
						   Opacity="0.6"
						   HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Grid>
		</Grid>

		<!-- Studios tab: studios with games in the library, the most played first -->
		<Grid Grid.Row="1" Margin="16,0,16,16"
			  IsVisible="{Binding IsStudiosTab}">
			<DataGrid Classes="statTable"
					  ItemsSource="{Binding StudioStats}"
					  IsVisible="{Binding HasStudioRows}"
					  views:DataGridBehavior.RowDoubleTapCommand="{Binding OpenStudioCommand}">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Студія" Width="*"
										Binding="{ReflectionBinding StudioName, Mode=OneWay}"/>
					<DataGridTextColumn Header="Ігор" Width="100"
										Binding="{ReflectionBinding GameCount, Mode=OneWay}"/>
					<DataGridTextColumn Header="Час" Width="140"
										Binding="{ReflectionBinding TotalHours, Mode=OneWay, Converter={x:Static conv:DurationConverter.Instance}}"/>
					<DataGridTextColumn Header="Середня оцінка" Width="150"
										Binding="{ReflectionBinding AverageRating, Mode=OneWay, StringFormat='{}{0:0.0} / 10', TargetNullValue={StaticResource NoValue}}"/>
				</DataGrid.Columns>
			</DataGrid>

			<TextBlock IsVisible="{Binding !HasStudioRows}"
					   Text="У бібліотеці ще немає ігор"
					   Opacity="0.6"
					   HorizontalAlignment="Center" VerticalAlignment="Center"/>
		</Grid>

		<!-- Genres tab: a game with several genres counts in each of them -->
		<Grid Grid.Row="1" Margin="16,0,16,16"
			  IsVisible="{Binding IsGenresTab}">
			<DataGrid Classes="statTable"
					  ItemsSource="{Binding GenreStats}"
					  IsVisible="{Binding HasGenreRows}">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Жанр" Width="*"
										Binding="{ReflectionBinding GenreName, Mode=OneWay}"/>
					<DataGridTextColumn Header="Ігор" Width="100"
										Binding="{ReflectionBinding GameCount, Mode=OneWay}"/>
					<DataGridTextColumn Header="Час" Width="140"
										Binding="{ReflectionBinding TotalHours, Mode=OneWay, Converter={x:Static conv:DurationConverter.Instance}}"/>
				</DataGrid.Columns>
			</DataGrid>

			<TextBlock IsVisible="{Binding !HasGenreRows}"
					   Text="Жодній грі бібліотеки ще не призначено жанр"
					   Opacity="0.6"
					   HorizontalAlignment="Center" VerticalAlignment="Center"/>
		</Grid>

		<!-- Activity tab: the period applies as soon as a date changes -->
		<Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="16,0,16,16"
			  IsVisible="{Binding IsActivityTab}">

			<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,0,0,8">
				<TextBlock Text="Період:" VerticalAlignment="Center" Opacity="0.6"/>
				<CalendarDatePicker SelectedDate="{Binding ActivityFrom}"
									SelectedDateFormat="Custom"
									CustomDateFormatString="dd.MM.yyyy"
									Width="150"/>
				<TextBlock Text="–" VerticalAlignment="Center"/>
				<CalendarDatePicker SelectedDate="{Binding ActivityTo}"
									SelectedDateFormat="Custom"
									CustomDateFormatString="dd.MM.yyyy"
									Width="150"/>
			</StackPanel>

			<DataGrid Grid.Row="1" Classes="statTable"
					  ItemsSource="{Binding ActivityDays}"
					  IsVisible="{Binding HasActivityRows}">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Дата" Width="*"
										Binding="{ReflectionBinding ActivityDate, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}"/>
					<DataGridTextColumn Header="Сесій" Width="100"
										Binding="{ReflectionBinding SessionCount, Mode=OneWay}"/>
					<DataGridTextColumn Header="Час" Width="140"
										Binding="{ReflectionBinding TotalSeconds, Mode=OneWay, Converter={x:Static conv:DurationConverter.Instance}}"/>
				</DataGrid.Columns>
			</DataGrid>

			<!-- No sessions in the period, or a hint about an incomplete or wrong period -->
			<TextBlock Grid.Row="1"
					   IsVisible="{Binding !HasActivityRows}"
					   Text="{Binding ActivityEmptyText}"
					   Opacity="0.6"
					   HorizontalAlignment="Center" VerticalAlignment="Center"/>
		</Grid>
	</Grid>
</UserControl>
