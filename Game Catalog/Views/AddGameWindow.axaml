<Window xmlns="https://github.com/avaloniaui"
		xmlns:conv="using:Game_Catalog.Converters"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:Game_Catalog.ViewModels"
		x:Class="Game_Catalog.Views.AddGameWindow"
		xmlns:models="using:Game_Catalog.Models"
		x:DataType="vm:AddGameViewModel"
		Title="{Binding WindowTitle}"
		Width="700"
		Height="640"
		WindowStartupLocation="CenterOwner"
		CanResize="False">

	<Window.Styles>
		<Style Selector="TabStripItem">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Padding" Value="16,8"/>
			<Setter Property="Margin" Value="0,0,0,-1"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource NavForeground}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="0"/>
		</Style>

		<Style Selector="TabStripItem:selected">
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SidebarBorder}"/>
			<Setter Property="Foreground" Value="{DynamicResource LogoForeground}"/>
		</Style>
	</Window.Styles>





	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Tabs -->
		<Border Grid.Row="0"
				BorderBrush="{DynamicResource SidebarBorder}"
				BorderThickness="0,0,0,1">
			<TabStrip SelectedIndex="{Binding SelectedTabIndex}">
				<TabStripItem Content="Деталі"/>
				<TabStripItem Content="Медіа"/>
			</TabStrip>
		</Border>

		<!-- Details tab -->
		<ScrollViewer Grid.Row="1" IsVisible="{Binding IsDetailsTab}">
			<Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto" Margin="24">

				<!-- Left column -->
				<StackPanel Grid.Row="0" Grid.Column="0" Spacing="12">

					<TextBlock Text="Назва гри"/>
					<Panel>
						<TextBox x:Name="TitleBox"
								 Text="{Binding Title}"
								 PlaceholderText="Введіть назву..."/>

						<!-- RAWG search suggestions popup -->
						<Popup IsOpen="{Binding IsSuggestionsVisible}"
							   IsLightDismissEnabled="True"
							   PlacementTarget="{Binding ElementName=TitleBox}"
							   Placement="Bottom"
							   MinWidth="400">
							<Border Background="{DynamicResource CardBackground}"
									BorderBrush="{DynamicResource SidebarBorder}"
									BorderThickness="1"
									CornerRadius="0,0,4,4"
									MaxHeight="220">
								<ListBox x:Name="SuggestionsList"
										 ItemsSource="{Binding Suggestions}"
										 Background="Transparent"
										 SelectionChanged="OnSuggestionSelected">
									<ListBox.ItemTemplate>
										<DataTemplate x:DataType="models:RawgGameResult">
											<TextBlock Text="{Binding Name}" Padding="4,2"/>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
							</Border>
						</Popup>
					</Panel>
					<TextBlock Text="🔍 Пошук у RAWG..."
							   FontSize="11"
							   Opacity="0.5"
							   IsVisible="{Binding IsSearching}"/>

					<TextBlock Text="Студія-розробник"/>
					<Grid ColumnDefinitions="*,Auto">
						<ComboBox Grid.Column="0"
								  ItemsSource="{Binding Studios}"
								  SelectedItem="{Binding SelectedStudio}"
								  HorizontalAlignment="Stretch">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Name}"/>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<Button Grid.Column="1"
								Content="+"
								Click="OnAddStudioClick"
								Margin="8,0,0,0"
								Padding="10,0"
								FontSize="16"
								VerticalAlignment="Top"
								ToolTip.Tip="Додати студію"/>
					</Grid>

					<!-- RAWG suggested developers -->
					<ItemsControl ItemsSource="{Binding SuggestedDeveloperNames}"
								  IsVisible="{Binding HasSuggestedDevelopers}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Button Content="{Binding StringFormat='+ Додати &quot;{0}&quot; до бази?'}"
										Tag="{Binding}"
										Click="OnSuggestStudioClick"
										Background="Transparent"
										Foreground="#4a9eff"
										Padding="0,2"
										Cursor="Hand"
										HorizontalAlignment="Left"/>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock Text="Жанр"/>
					<TextBox Text="{Binding Genre}"
							 PlaceholderText="Введіть жанр..."/>

					<TextBlock Text="Платформа"/>
					<TextBox Text="{Binding Platform}"
							 PlaceholderText="PC, PlayStation, Xbox..."/>
				</StackPanel>

				<!-- Right column -->
				<StackPanel Grid.Row="0" Grid.Column="2" Spacing="12">

					<TextBlock Text="Рік випуску"/>
					<NumericUpDown Value="{Binding ReleaseYear, Converter={x:Static conv:DecimalToIntConverter.Instance}}"
								   FormatString="0"/>

					<TextBlock Text="Статус"/>
					<ComboBox ItemsSource="{Binding Statuses}"
							  SelectedItem="{Binding Status}"
							  HorizontalAlignment="Stretch">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding, Converter={x:Static conv:GameStatusConverter.Instance}}"/>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>

					<TextBlock Text="Особиста оцінка (1-10)"/>
					<NumericUpDown Value="{Binding PersonalRating, Converter={x:Static conv:DecimalToIntConverter.Instance}}"
								   Minimum="1" Maximum="10" FormatString="0"/>

					<TextBlock Text="Розмір на диску (ГБ)"/>
					<NumericUpDown Value="{Binding SizeGB, Converter={x:Static conv:DecimalToDoubleConverter.Instance}}"
								   Increment="0.5" FormatString="0.0"/>
					<TextBlock Text="{Binding DiskOverflowError}"
							   IsVisible="{Binding HasDiskOverflowError}"
							   Foreground="#e05252"
							   FontSize="11"
							   TextWrapping="Wrap"/>
				</StackPanel>

				<!-- Description (full width) -->
				<StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
							Spacing="4" Margin="0,12,0,0">
					<TextBlock Text="Опис"/>
					<TextBox Text="{Binding Description}"
							 PlaceholderText="Додайте опис або нотатки (до 1000 символів)..."
							 TextWrapping="Wrap"
							 AcceptsReturn="True"
							 MaxLength="1000"
							 Height="120"/>
				</StackPanel>
			</Grid>
		</ScrollViewer>

		<!-- Media tab -->
		<Grid Grid.Row="1" ColumnDefinitions="*,24,180" Margin="24"
			  IsVisible="{Binding IsMediaTab}">

			<!-- Cover -->
			<StackPanel Grid.Column="0" Spacing="8">
				<TextBlock Text="Обкладинка"/>
				<Border Height="300" CornerRadius="8" ClipToBounds="True"
						Background="{DynamicResource CardBackground}">
					<Panel>
						<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
									IsVisible="{Binding CoverImagePath, Converter={x:Static StringConverters.IsNullOrEmpty}}">
							<TextBlock Text="🎮" FontSize="36" HorizontalAlignment="Center"/>
							<TextBlock Text="Обкладинка не вибрана" FontSize="11" Opacity="0.5"
									   TextAlignment="Center" Margin="8,6,8,0"/>
						</StackPanel>
						<Image Source="{Binding CoverImagePath, Converter={x:Static conv:PathToBitmapConverter.Instance}, ConverterParameter=320}"
							   Stretch="UniformToFill"
							   IsVisible="{Binding CoverImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
					</Panel>
				</Border>
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Button Content="📁 Обрати файл" Click="OnPickCoverClick"/>
					<Button Content="✕ Очистити" Click="OnClearCoverClick"
							IsVisible="{Binding CoverImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
				</StackPanel>
			</StackPanel>

			<!-- Icon -->
			<StackPanel Grid.Column="2" Spacing="8">
				<TextBlock Text="Іконка"/>
				<Border Width="96" Height="96" HorizontalAlignment="Left"
						Background="{DynamicResource CardBackground}">
					<Panel>
						<TextBlock Text="🎮" FontSize="32"
								   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"
								   IsVisible="{Binding IconPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
						<Image Source="{Binding IconPath, Converter={x:Static conv:PathToBitmapConverter.Instance}, ConverterParameter=128}"
							   Stretch="Uniform"
							   IsVisible="{Binding IconPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
					</Panel>
				</Border>
				<Button Content="📁 Обрати файл" Click="OnPickIconClick"/>
				<Button Content="✕ Очистити" Click="OnClearIconClick"
						IsVisible="{Binding IconPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
			</StackPanel>
		</Grid>

		<!-- Bottom action buttons -->
		<Border Grid.Row="2"
				Padding="24,12"
				BorderBrush="{DynamicResource SidebarBorder}"
				BorderThickness="0,1,0,0">
			<StackPanel Orientation="Horizontal"
						Spacing="8"
						HorizontalAlignment="Right">
				<Button Content="Скасувати"
						Command="{Binding CancelCommand}"/>
				<Button Content="Зберегти"
						Command="{Binding ConfirmCommand}"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>