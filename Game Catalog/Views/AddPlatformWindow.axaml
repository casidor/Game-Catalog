<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:Game_Catalog.ViewModels"
		x:Class="Game_Catalog.Views.AddPlatformWindow"
		x:DataType="vm:AddPlatformViewModel"
		Title="{Binding WindowTitle}"
		Width="450"
		SizeToContent="Height"
		WindowStartupLocation="CenterOwner"
		CanResize="False">
	<StackPanel Spacing="12" Margin="24">

		<TextBlock Text="Назва платформи"/>
		<TextBox Text="{Binding PlatformName}"
				 PlaceholderText="Введіть назву..."/>

		<TextBlock Text="Виробник"/>
		<TextBox Text="{Binding Manufacturer}"
				 PlaceholderText="Необов'язково..."/>

		<StackPanel Orientation="Horizontal"
					Spacing="8"
					HorizontalAlignment="Right"
					Margin="0,8,0,0">
			<Button Content="Скасувати" Command="{Binding CancelCommand}"/>
			<Button Content="Зберегти" Command="{Binding ConfirmCommand}"/>
		</StackPanel>

	</StackPanel>
</Window>