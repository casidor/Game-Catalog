<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:v="using:Game_Catalog.Views"
			 xmlns:conv="using:Game_Catalog.Converters"
			 x:Class="Game_Catalog.Views.PlatformIcon"
			 Width="16" Height="16">

	<!-- The icon, or a circle with a question mark when there is none or its file is missing -->
	<Panel>
		<Viewbox IsVisible="{Binding #Icon.Source, Converter={x:Static ObjectConverters.IsNull}}">
			<Border Width="16" Height="16" CornerRadius="8" Background="#40808080">
				<TextBlock Text="?" FontSize="10" FontWeight="Bold"
						   HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Border>
		</Viewbox>
		<Image x:Name="Icon" Stretch="Uniform"
			   Source="{Binding $parent[v:PlatformIcon].IconPath, Converter={x:Static conv:PathToBitmapConverter.Instance}, ConverterParameter=64}"/>
	</Panel>

</UserControl>