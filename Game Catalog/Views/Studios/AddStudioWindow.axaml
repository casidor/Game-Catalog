<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:Game_Catalog.ViewModels"
		xmlns:conv="using:Game_Catalog.Converters"
		x:Class="Game_Catalog.Views.AddStudioWindow"
		x:DataType="vm:AddStudioViewModel"
		Title="{Binding WindowTitle}"
		Width="450"
		SizeToContent="Height"
		WindowStartupLocation="CenterOwner"
		CanResize="False">

	<Window.Styles>
		<Style Selector="DropDownButton.field">
			<Setter Property="Background" Value="{DynamicResource ComboBoxBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrush}"/>
			<Setter Property="BorderThickness" Value="{DynamicResource ComboBoxBorderThemeThickness}"/>
			<Setter Property="Padding" Value="{DynamicResource ComboBoxPadding}"/>
			<Setter Property="Foreground" Value="{DynamicResource ComboBoxForeground}"/>
			<Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
		</Style>
		<Style Selector="DropDownButton.field:pointerover /template/ Border#RootBorder">
			<Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundPointerOver}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrushPointerOver}"/>
		</Style>
		<Style Selector="DropDownButton.field:pressed">
			<Setter Property="RenderTransform" Value="none"/>
		</Style>
		<Style Selector="DropDownButton.field:pressed /template/ Border#RootBorder">
			<Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundPressed}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrushPressed}"/>
		</Style>
	</Window.Styles>

	<StackPanel Spacing="12" Margin="24">

		<TextBlock Text="Назва студії"/>
		<TextBox Text="{Binding StudioName}"
				 PlaceholderText="Введіть назву..."/>

		<TextBlock Text="Країна"/>
		<DropDownButton x:Name="CountryButton"
				Classes="field"
				Content="{Binding CountryButtonText}"
				HorizontalAlignment="Stretch"
				HorizontalContentAlignment="Left">
			<DropDownButton.Flyout>
				<Flyout Placement="Bottom" Opened="OnCountryFlyoutOpened">
					<StackPanel Width="280" Spacing="8">
						<TextBox Text="{Binding CountrySearchText}"
								 PlaceholderText="🔍 Пошук країни..."/>
						<ListBox ItemsSource="{Binding FilteredCountries}"
								 SelectionChanged="OnCountrySelected"
								 Height="220">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="x:String">
									<TextBlock Text="{Binding}" Padding="4,2"/>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</StackPanel>
				</Flyout>
			</DropDownButton.Flyout>
		</DropDownButton>

		<TextBlock Text="Рік заснування"/>
		<NumericUpDown Value="{Binding FoundationYear, Converter={x:Static conv:DecimalToNullableIntConverter.Instance}}"
					   FormatString="0"/>

		<TextBlock Text="Основний жанр"/>
		<Grid ColumnDefinitions="*,Auto">
			<ComboBox Grid.Column="0"
					  ItemsSource="{Binding GenreOptions}"
					  SelectedItem="{Binding SelectedGenre}"
					  HorizontalAlignment="Stretch">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding GenreName, TargetNullValue='Не вказано', FallbackValue='Не вказано'}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
			<Button Grid.Column="1"
					Content="+"
					Command="{Binding AddGenreCommand}"
					Margin="8,0,0,0"
					Padding="10,0"
					FontSize="16"
					VerticalAlignment="Top"
					ToolTip.Tip="Додати жанр"/>
		</Grid>

		<TextBlock Text="Сайт студії"/>
		<TextBox Text="{Binding Website}"
				 PlaceholderText="https://..."/>

		<StackPanel Orientation="Horizontal"
					Spacing="8"
					HorizontalAlignment="Right"
					Margin="0,8,0,0">
			<Button Content="Скасувати" Command="{Binding CancelCommand}"/>
			<Button Content="Зберегти" Command="{Binding ConfirmCommand}"/>
		</StackPanel>

	</StackPanel>
</Window>