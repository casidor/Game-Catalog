<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Game_Catalog.ViewModels"
			 xmlns:conv="using:Game_Catalog.Converters"
			 xmlns:views="using:Game_Catalog.Views"
			 x:Class="Game_Catalog.Views.StudioDetailsView"
			 x:DataType="vm:StudioDetailsViewModel">

	<UserControl.Styles>
		<Style Selector="Border.badge">
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="8,1"/>
			<Setter Property="Margin" Value="8,0,0,0"/>
			<Setter Property="Background" Value="#30808080"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.badge > TextBlock">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">

		<!-- Top bar: back, the name with the studio facts under it, and the studio actions -->
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,8,156,8">
			<Button Grid.Column="0" Content="← Назад"
					Command="{Binding GoBackCommand}" Padding="8,4"
					VerticalAlignment="Center"/>
			<StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
				<TextBlock Text="{Binding Name}"
						   FontSize="24" FontWeight="Bold"
						   TextTrimming="CharacterEllipsis"/>
				<StackPanel Orientation="Horizontal" IsVisible="{Binding HasSubtitle}">
					<TextBlock Text="{Binding FactsText}" IsVisible="{Binding HasFacts}"
							   FontSize="13" Opacity="0.6" VerticalAlignment="Center"/>
					<TextBlock Text=" · " IsVisible="{Binding ShowWebsiteSeparator}"
							   FontSize="13" Opacity="0.6" VerticalAlignment="Center"/>
					<HyperlinkButton Padding="0" FontSize="13"
									 NavigateUri="{Binding WebsiteUri}"
									 IsVisible="{Binding HasWebsite}"
									 ToolTip.Tip="{Binding DisplayWebsite}">
						<TextBlock Text="{Binding DisplayWebsite}" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
					</HyperlinkButton>
				</StackPanel>
			</StackPanel>
			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
						VerticalAlignment="Center">
				<Button Content="✏ Редагувати" Command="{Binding EditCommand}"/>
				<Button Content="🗑 Видалити" Command="{Binding DeleteCommand}"/>
			</StackPanel>
		</Grid>

		<!-- Games of the studio -->
		<Grid Grid.Row="1" RowDefinitions="40,*" Margin="8,0,8,8">

			<TextBlock Grid.Row="0" Text="{Binding GamesSummary}"
					   IsVisible="{Binding !IsGamesEmpty}"
					   Opacity="0.7" Margin="16,0" VerticalAlignment="Center"/>

			<!-- Read-only table; the DLC of a game open under its row when the row is selected -->
			<DataGrid Grid.Row="1"
					  Classes="table"
					  IsVisible="{Binding !IsGamesEmpty}"
					  ItemsSource="{Binding Rows}"
					  CanUserSortColumns="False"
					  SelectionMode="Single"
					  RowDetailsVisibilityMode="VisibleWhenSelected"
					  views:DataGridBehavior.RowDoubleTapCommand="{Binding OpenGameCommand}">

				<DataGrid.Columns>
					<DataGridTemplateColumn Header="Назва" Width="*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="vm:StudioGameRow">
								<!-- The icon slot shows in every row once any game has an icon, so the titles stay in line -->
								<Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
									<Image Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0"
										   VerticalAlignment="Center"
										   RenderOptions.BitmapInterpolationMode="HighQuality"
										   IsVisible="{Binding $parent[DataGrid].((vm:StudioDetailsViewModel)DataContext).ShowIcons}"
										   Source="{Binding IconPath, Converter={x:Static conv:PathToBitmapConverter.Instance}, ConverterParameter=64}"/>
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock Text="{Binding Title}"
												   TextTrimming="CharacterEllipsis" MaxLines="1"/>
										<TextBlock Text="{Binding ParentText}"
												   IsVisible="{Binding IsDlc}"
												   FontSize="11" Opacity="0.6"
												   TextTrimming="CharacterEllipsis" MaxLines="1"/>
									</StackPanel>
									<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
										<Border Classes="badge" IsVisible="{Binding IsDlc}">
											<TextBlock Text="DLC"/>
										</Border>
										<Border Classes="badge" IsVisible="{Binding IsArchived}">
											<TextBlock Text="Архів"/>
										</Border>
										<Border Classes="badge" IsVisible="{Binding HasDlcs}">
											<TextBlock Text="{Binding DlcBadgeText}"/>
										</Border>
									</StackPanel>
								</Grid>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Header="Рік" Width="90">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="vm:StudioGameRow">
								<TextBlock Text="{Binding YearText, TargetNullValue={StaticResource NoValue}}"
										   VerticalAlignment="Center" Margin="12,0"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Header="Статус" Width="160">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="vm:StudioGameRow">
								<TextBlock Text="{Binding Status, Converter={x:Static conv:GameStatusConverter.Instance}}"
										   VerticalAlignment="Center" Margin="12,0"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Header="Оцінка" Width="90">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="vm:StudioGameRow">
								<TextBlock Text="{Binding RatingText, TargetNullValue={StaticResource NoValue}}"
										   VerticalAlignment="Center" Margin="12,0"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>

				<!-- DLC of the selected game, one short line each -->
				<DataGrid.RowDetailsTemplate>
					<DataTemplate x:DataType="vm:StudioGameRow">
						<ItemsControl ItemsSource="{Binding Dlcs}"
									  IsVisible="{Binding HasDlcs}"
									  Margin="12,0,12,8">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:StudioGameRow">
									<StackPanel Orientation="Horizontal" Height="30" Spacing="8">
										<!-- Same width as the icon slot of the game rows, so the DLC line up under the title -->
										<Border Width="34"
												IsVisible="{Binding $parent[DataGrid].((vm:StudioDetailsViewModel)DataContext).ShowIcons}"/>
										<TextBlock Text="↳" Opacity="0.5" VerticalAlignment="Center"/>
										<TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
										<TextBlock Text="{Binding YearText}"
												   IsVisible="{Binding YearText, Converter={x:Static ObjectConverters.IsNotNull}}"
												   Opacity="0.6" VerticalAlignment="Center"/>
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</DataTemplate>
				</DataGrid.RowDetailsTemplate>
			</DataGrid>

			<!-- Empty state -->
			<TextBlock Grid.Row="0" Grid.RowSpan="2"
					   Text="У студії ще немає ігор"
					   IsVisible="{Binding IsGamesEmpty}"
					   Opacity="0.6"
					   HorizontalAlignment="Center" VerticalAlignment="Center"/>
		</Grid>

	</Grid>
</UserControl>
