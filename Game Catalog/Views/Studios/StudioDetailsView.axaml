<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Game_Catalog.ViewModels"
			 x:Class="Game_Catalog.Views.StudioDetailsView"
			 x:DataType="vm:StudioDetailsViewModel">

	<Grid RowDefinitions="Auto,*">

		<!-- Page header -->
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,16,16,0">
			<Button Grid.Column="0"
					Content="← Назад"
					Command="{Binding GoBackCommand}"
					Padding="8,4"/>
			<TextBlock Grid.Column="1"
					   Text="{Binding Name}"
					   FontSize="24"
					   FontWeight="Bold"
					   VerticalAlignment="Center"
					   TextTrimming="CharacterEllipsis"
					   Margin="16,0"/>
			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
				<Button Content="✏ Редагувати" Command="{Binding EditCommand}"/>
				<Button Content="🗑 Видалити" Command="{Binding DeleteCommand}"/>
			</StackPanel>
		</Grid>

		<!-- Page content -->
		<ScrollViewer Grid.Row="1" Margin="16,16,16,0">
			<WrapPanel Orientation="Horizontal">

				<Border Background="{DynamicResource CardBackground}"
						CornerRadius="8" Padding="16" Margin="0,0,8,8" MinWidth="140">
					<StackPanel Spacing="4">
						<TextBlock Text="Країна" FontSize="11" Opacity="0.5"/>
						<TextBlock Text="{Binding DisplayCountry, TargetNullValue={StaticResource NoValue}}" FontSize="14" FontWeight="SemiBold"/>
					</StackPanel>
				</Border>

				<Border Background="{DynamicResource CardBackground}"
						CornerRadius="8" Padding="16" Margin="0,0,8,8" MinWidth="140">
					<StackPanel Spacing="4">
						<TextBlock Text="Рік заснування" FontSize="11" Opacity="0.5"/>
						<TextBlock Text="{Binding DisplayFoundationYear, TargetNullValue={StaticResource NoValue}}" FontSize="14" FontWeight="SemiBold"/>
					</StackPanel>
				</Border>

				<Border Background="{DynamicResource CardBackground}"
						CornerRadius="8" Padding="16" Margin="0,0,8,8" MinWidth="140">
					<StackPanel Spacing="4">
						<TextBlock Text="Основний жанр" FontSize="11" Opacity="0.5"/>
						<TextBlock Text="{Binding DisplayMainGenre, TargetNullValue={StaticResource NoValue}}" FontSize="14" FontWeight="SemiBold"/>
					</StackPanel>
				</Border>

				<Border Background="{DynamicResource CardBackground}"
						CornerRadius="8" Padding="16" Margin="0,0,8,8" MinWidth="140">
					<StackPanel Spacing="4">
						<TextBlock Text="Сайт" FontSize="11" Opacity="0.5"/>
						<Button Command="{Binding OpenWebsiteCommand}"
								IsEnabled="{Binding HasWebsite}"
								Background="Transparent" Padding="0" Cursor="Hand">
							<TextBlock Text="{Binding DisplayWebsite, TargetNullValue={StaticResource NoValue}}"
									   FontSize="14" FontWeight="SemiBold"
									   TextDecorations="Underline"/>
						</Button>
					</StackPanel>
				</Border>

			</WrapPanel>
		</ScrollViewer>

	</Grid>
</UserControl>