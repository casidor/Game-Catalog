<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Game_Catalog.ViewModels"
			 xmlns:views="using:Game_Catalog.Views"
			 x:Class="Game_Catalog.Views.DictionariesView"
			 x:DataType="vm:DictionariesViewModel">

	<Grid RowDefinitions="Auto,*">

		<!-- Top bar: title with adding, then search and tabs; adding and search act on the selected tab -->
		<Border Grid.Row="0" Padding="16,12" Margin="{StaticResource CaptionButtonsInset}">
			<Grid ColumnDefinitions="Auto,*,Auto">
				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<TextBlock Text="Довідники"
							   FontSize="20" FontWeight="Bold"
							   VerticalAlignment="Center"/>
					<Button Content="+" ToolTip.Tip="{Binding CurrentTab.AddTip}"
							Width="32" Padding="0" FontSize="18"
							Command="{Binding CurrentTab.AddCommand}"
							VerticalAlignment="Center"/>
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,16,0"
							HorizontalAlignment="Right" VerticalAlignment="Center">
					<TextBlock Text="{Binding CurrentTab.SearchSummary}"
							   IsVisible="{Binding CurrentTab.SearchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							   FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
					<TextBox Text="{Binding CurrentTab.SearchText}"
							 PlaceholderText="{Binding CurrentTab.SearchPlaceholder}"
							 Width="220" VerticalAlignment="Center"/>
				</StackPanel>
				<TabStrip Grid.Column="2" VerticalAlignment="Center"
						  SelectedIndex="{Binding SelectedTabIndex}">
					<TabStrip.Styles>
						<Style Selector="TabStripItem">
							<Setter Property="FontSize" Value="16"/>
							<Setter Property="MinHeight" Value="40"/>
						</Style>
					</TabStrip.Styles>
					<TabStripItem Content="Жанри"/>
					<TabStripItem Content="Платформи"/>
					<TabStripItem Content="Теги"/>
				</TabStrip>
			</Grid>
		</Border>

		<Panel Grid.Row="1" IsVisible="{Binding IsGenresTab}">
			<views:GenresTabView DataContext="{Binding Genres}"/>
		</Panel>

		<Panel Grid.Row="1" IsVisible="{Binding IsPlatformsTab}">
			<views:PlatformsTabView DataContext="{Binding Platforms}"/>
		</Panel>

		<Panel Grid.Row="1" IsVisible="{Binding IsTagsTab}">
			<views:TagsTabView DataContext="{Binding Tags}"/>
		</Panel>

	</Grid>
</UserControl>
