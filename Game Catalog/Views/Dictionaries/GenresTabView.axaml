<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Game_Catalog.ViewModels"
			 xmlns:views="using:Game_Catalog.Views"
			 xmlns:models="using:Game_Catalog.Models"
			 x:Class="Game_Catalog.Views.GenresTabView"
			 x:DataType="vm:GenresViewModel">

	<Grid>

		<!-- Table: sorted by the database, search matches are highlighted -->
		<DataGrid Classes="table searchable dbSort"
				  ItemsSource="{Binding Rows}"
				  IsVisible="{Binding !IsEmpty}"
				  CanUserSortColumns="True"
				  SelectionMode="Extended"
				  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
				  views:DataGridBehavior.SelectedItems="{Binding SelectedRows}"
				  views:DataGridBehavior.RowDoubleTapCommand="{Binding EditCommand}"
				  views:DataGridBehavior.DeleteCommand="{Binding DeleteSelectedCommand}"
				  x:Name="GenresGrid">

			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Header="Редагувати"
							  Command="{Binding EditSelectedCommand}"/>
					<Separator/>
					<MenuItem Header="{Binding DeleteSelectedHeader}"
							  Command="{Binding DeleteSelectedCommand}"
							  InputGesture="Delete"/>
				</ContextMenu>
			</DataGrid.ContextMenu>

			<DataGrid.Columns>
				<DataGridTextColumn Header="Назва" Width="220"
									Binding="{ReflectionBinding Item.GenreName}"
									Tag="{x:Static models:DictionarySortField.Name}"/>
				<DataGridTemplateColumn Header="Опис" Width="*" CanUserSort="False">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Border Background="Transparent"
									ToolTip.Tip="{ReflectionBinding Description}">
								<TextBlock Text="{ReflectionBinding Description, TargetNullValue={StaticResource NoValue}}"
										   TextTrimming="CharacterEllipsis"
										   MaxLines="1"
										   VerticalAlignment="Center"
										   Margin="12,0"/>
							</Border>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>

		<!-- Empty state -->
		<StackPanel IsVisible="{Binding IsEmpty}"
					HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
			<TextBlock Text="🏷" FontSize="48" HorizontalAlignment="Center"/>
			<TextBlock Text="Жанрів немає" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
			<TextBlock Text="Додайте перший жанр" Opacity="0.6" HorizontalAlignment="Center"/>
		</StackPanel>

	</Grid>
</UserControl>
