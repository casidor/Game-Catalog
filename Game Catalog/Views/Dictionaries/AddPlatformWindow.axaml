<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:Game_Catalog.ViewModels"
		xmlns:conv="using:Game_Catalog.Converters"
		x:Class="Game_Catalog.Views.AddPlatformWindow"
		x:DataType="vm:AddPlatformViewModel"
		Title="{Binding WindowTitle}"
		Width="520"
		SizeToContent="Height"
		WindowStartupLocation="CenterOwner"
		CanResize="False">
	<StackPanel Spacing="12" Margin="24">

		<!-- Left: icon preview with its menu; right: fields of the same height -->
		<Grid ColumnDefinitions="88,20,*">

			<StackPanel Grid.Column="0" Spacing="8">
				<Border Width="80" Height="80" HorizontalAlignment="Center"
						Background="{DynamicResource CardBackground}">
					<Panel>
						<TextBlock Text="?" FontSize="32"
								   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"
								   IsVisible="{Binding !HasIcon}"/>
						<Image Source="{Binding PlatformIconPath, Converter={x:Static conv:PathToBitmapConverter.Instance}, ConverterParameter=128}"
							   Stretch="Uniform"
							   IsVisible="{Binding HasIcon}"/>
					</Panel>
				</Border>
				<DropDownButton Content="Іконка" HorizontalAlignment="Stretch">
					<DropDownButton.Flyout>
						<MenuFlyout Placement="Bottom">
							<MenuItem Header="➕ Обрати файл…" Command="{Binding PickIconCommand}"/>
							<MenuItem Header="🔗 Завантажити за URL…" Command="{Binding DownloadIconCommand}"/>
							<MenuItem Header="🗑 Прибрати" Command="{Binding ClearIconCommand}"
									  IsVisible="{Binding HasIcon}"/>
						</MenuFlyout>
					</DropDownButton.Flyout>
				</DropDownButton>
			</StackPanel>

			<StackPanel Grid.Column="2" Spacing="12">
				<StackPanel Spacing="4">
					<TextBlock Text="Назва платформи"/>
					<TextBox Text="{Binding PlatformName}"
							 PlaceholderText="Введіть назву..."/>
				</StackPanel>
				<StackPanel Spacing="4">
					<TextBlock Text="Виробник"/>
					<TextBox Text="{Binding Manufacturer}"
							 PlaceholderText="Необов'язково..."/>
				</StackPanel>
			</StackPanel>

		</Grid>

		<StackPanel Spacing="2" IsVisible="{Binding HasIcon}">
			<TextBlock Text="{Binding IconReport.Info}" FontSize="12"/>
			<TextBlock Text="{Binding IconReport.Warning}"
					   IsVisible="{Binding IconReport.HasWarning}"
					   Foreground="#e0a030" FontSize="11" TextWrapping="Wrap"/>
		</StackPanel>
		<TextBlock Text="Рекомендовано: квадратне зображення від 64×64, PNG із прозорим тлом"
				   FontSize="11" Opacity="0.5" TextWrapping="Wrap"
				   IsVisible="{Binding !HasIcon}"/>

		<StackPanel Orientation="Horizontal"
					Spacing="8"
					HorizontalAlignment="Right"
					Margin="0,8,0,0">
			<Button Content="Скасувати" Command="{Binding CancelCommand}"/>
			<Button Content="Зберегти" Command="{Binding ConfirmCommand}"/>
		</StackPanel>

	</StackPanel>
</Window>