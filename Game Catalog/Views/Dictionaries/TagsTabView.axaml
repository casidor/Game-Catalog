<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Game_Catalog.ViewModels"
			 xmlns:models="using:Game_Catalog.Models"
			 xmlns:conv="using:Game_Catalog.Converters"
			 x:Class="Game_Catalog.Views.TagsTabView"
			 x:DataType="vm:TagsViewModel">

	<Grid RowDefinitions="Auto,*">

		<!-- Toolbar -->
		<Border Grid.Row="0" Padding="16,12">
			<Grid ColumnDefinitions="Auto,*">
				<Button Grid.Column="0" Content="+ Додати тег"
						Command="{Binding AddCommand}"
						VerticalAlignment="Center"/>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
							HorizontalAlignment="Right" VerticalAlignment="Center">
					<TextBlock Text="{Binding SearchSummary}"
							   IsVisible="{Binding SearchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							   FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
					<TextBox Text="{Binding SearchText}"
							 PlaceholderText="🔍 Пошук тегу..."
							 Width="220" VerticalAlignment="Center"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Table: sorted by the database, search matches are highlighted -->
		<DataGrid Grid.Row="1"
				  ItemsSource="{Binding Rows}"
				  IsVisible="{Binding !IsEmpty}"
				  AutoGenerateColumns="False"
				  IsReadOnly="True"
				  CanUserSortColumns="True"
				  CanUserResizeColumns="True"
				  CanUserReorderColumns="False"
				  GridLinesVisibility="None"
				  HeadersVisibility="Column"
				  BorderThickness="0"
				  Background="Transparent"
				  RowHeight="44"
				  Margin="8,0"
				  Classes="dbSort"
				  x:Name="TagsGrid">

			<DataGrid.Styles>
				<Style Selector="DataGridColumnHeader">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="FontSize" Value="12"/>
				</Style>
				<Style Selector="DataGridRow">
					<Setter Property="Background"
							Value="{ReflectionBinding IsMatch, Converter={x:Static conv:SearchMatchBrushConverter.Instance}}"/>
				</Style>
			</DataGrid.Styles>

			<DataGrid.Columns>
				<DataGridTemplateColumn Header="" Width="44" CanUserSort="False" CanUserResize="False">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Ellipse Width="14" Height="14"
									 HorizontalAlignment="Center" VerticalAlignment="Center"
									 Fill="{ReflectionBinding Item.Color, Converter={x:Static conv:TagColorConverter.Instance}}"
									 Stroke="{DynamicResource NavForeground}"
									 StrokeThickness="1"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn Header="Назва" Width="*"
									Binding="{ReflectionBinding Item.TagName}"
									Tag="{x:Static models:DictionarySortField.Name}"/>
				<DataGridTemplateColumn Header="" Width="100" CanUserSort="False" CanUserResize="False">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
								<Button Content="✏" ToolTip.Tip="Редагувати"
										Command="{ReflectionBinding $parent[DataGrid].DataContext.EditCommand}"
										CommandParameter="{ReflectionBinding Item}"/>
								<Button Content="🗑" ToolTip.Tip="Видалити"
										Command="{ReflectionBinding $parent[DataGrid].DataContext.DeleteCommand}"
										CommandParameter="{ReflectionBinding Item}"/>
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>

		<!-- Empty state -->
		<StackPanel Grid.Row="1" IsVisible="{Binding IsEmpty}"
					HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
			<TextBlock Text="🔖" FontSize="48" HorizontalAlignment="Center"/>
			<TextBlock Text="Тегів немає" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
			<TextBlock Text="Додайте перший тег" Opacity="0.6" HorizontalAlignment="Center"/>
		</StackPanel>

	</Grid>
</UserControl>
