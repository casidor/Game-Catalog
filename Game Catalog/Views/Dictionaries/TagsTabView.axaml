<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Game_Catalog.ViewModels"
			 xmlns:views="using:Game_Catalog.Views"
			 xmlns:models="using:Game_Catalog.Models"
			 xmlns:conv="using:Game_Catalog.Converters"
			 x:Class="Game_Catalog.Views.TagsTabView"
			 x:DataType="vm:TagsViewModel">

	<Grid>

		<!-- Table: sorted by the database, search matches are highlighted -->
		<DataGrid Classes="table searchable dbSort"
				  ItemsSource="{Binding Rows}"
				  IsVisible="{Binding !IsEmpty}"
				  CanUserSortColumns="True"
				  SelectionMode="Extended"
				  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
				  views:DataGridBehavior.SelectedItems="{Binding SelectedRows}"
				  views:DataGridBehavior.RowDoubleTapCommand="{Binding EditCommand}"
				  views:DataGridBehavior.DeleteCommand="{Binding DeleteSelectedCommand}"
				  x:Name="TagsGrid">

			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Header="Редагувати"
							  Command="{Binding EditSelectedCommand}"/>
					<Separator/>
					<MenuItem Header="{Binding DeleteSelectedHeader}"
							  Command="{Binding DeleteSelectedCommand}"
							  InputGesture="Delete"/>
				</ContextMenu>
			</DataGrid.ContextMenu>

			<DataGrid.Columns>
				<DataGridTemplateColumn Header="" Width="44" CanUserSort="False" CanUserResize="False">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Ellipse Width="20" Height="20"
									 HorizontalAlignment="Center" VerticalAlignment="Center"
									 Fill="{ReflectionBinding Item.Color, Converter={x:Static conv:TagColorConverter.Instance}}"
									 Stroke="#60808080"
									 StrokeThickness="1"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn Header="Назва" Width="*"
									Binding="{ReflectionBinding Item.TagName}"
									Tag="{x:Static models:DictionarySortField.Name}"/>
			</DataGrid.Columns>
		</DataGrid>

		<!-- Empty state -->
		<StackPanel IsVisible="{Binding IsEmpty}"
					HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
			<TextBlock Text="🔖" FontSize="48" HorizontalAlignment="Center"/>
			<TextBlock Text="Тегів немає" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
			<TextBlock Text="Додайте перший тег" Opacity="0.6" HorizontalAlignment="Center"/>
		</StackPanel>

	</Grid>
</UserControl>
