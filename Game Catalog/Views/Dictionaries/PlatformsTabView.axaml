<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Game_Catalog.ViewModels"
			 xmlns:views="using:Game_Catalog.Views"
			 xmlns:models="using:Game_Catalog.Models"
			 x:Class="Game_Catalog.Views.PlatformsTabView"
			 x:DataType="vm:PlatformsViewModel">

	<Grid>

		<!-- Table: sorted by the database, search matches are highlighted -->
		<DataGrid Classes="table searchable dbSort"
				  ItemsSource="{Binding Rows}"
				  IsVisible="{Binding !IsEmpty}"
				  CanUserSortColumns="True"
				  SelectionMode="Extended"
				  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
				  views:DataGridBehavior.SelectedItems="{Binding SelectedRows}"
				  views:DataGridBehavior.RowDoubleTapCommand="{Binding EditCommand}"
				  views:DataGridBehavior.DeleteCommand="{Binding DeleteSelectedCommand}"
				  x:Name="PlatformsGrid">

			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Header="Редагувати"
							  Command="{Binding EditSelectedCommand}"/>
					<Separator/>
					<MenuItem Header="{Binding DeleteSelectedHeader}"
							  Command="{Binding DeleteSelectedCommand}"
							  InputGesture="Delete"/>
				</ContextMenu>
			</DataGrid.ContextMenu>

			<DataGrid.Columns>
				<DataGridTextColumn Header="Назва" Width="*"
									Binding="{ReflectionBinding Item.PlatformName}"
									Tag="{x:Static models:DictionarySortField.Name}"/>
				<DataGridTextColumn Header="Виробник" Width="*"
					Binding="{ReflectionBinding Manufacturer, TargetNullValue={StaticResource NoValue}}"
					CanUserSort="True"
					Tag="{x:Static models:DictionarySortField.Manufacturer}"/>
			</DataGrid.Columns>
		</DataGrid>

		<!-- Empty state -->
		<StackPanel IsVisible="{Binding IsEmpty}"
					HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
			<TextBlock Text="🕹" FontSize="48" HorizontalAlignment="Center"/>
			<TextBlock Text="Платформ немає" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
			<TextBlock Text="Додайте першу платформу" Opacity="0.6" HorizontalAlignment="Center"/>
		</StackPanel>

	</Grid>
</UserControl>
