<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="Game_Catalog.Views.InputWindow"
		Width="460"
		SizeToContent="Height"
		WindowStartupLocation="CenterOwner"
		CanResize="False">
	<StackPanel Spacing="12" Margin="24">
		<TextBlock x:Name="PromptText"/>
		<TextBox x:Name="InputBox"/>
		<TextBlock x:Name="ErrorText" Foreground="#e05252" FontSize="12"
				   TextWrapping="Wrap" IsVisible="False"/>
		<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
			<Button x:Name="CancelButton" Content="Скасувати"/>
			<Button x:Name="ConfirmButton"/>
		</StackPanel>
	</StackPanel>
</Window>