<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:Game_Catalog.ViewModels"
		xmlns:models="using:Game_Catalog.Models"
		xmlns:conv="using:Game_Catalog.Converters"
		x:Class="Game_Catalog.Views.AddSessionWindow"
		x:DataType="vm:AddSessionViewModel"
		Title="{Binding WindowTitle}"
		Width="580"
		SizeToContent="Height"
		WindowStartupLocation="CenterOwner"
		CanResize="False">
	<StackPanel Spacing="12" Margin="24">

		<TextBlock Text="Гра"/>
		<ComboBox ItemsSource="{Binding Games}"
				  SelectedItem="{Binding SelectedGame}"
				  HorizontalAlignment="Stretch">
			<ComboBox.ItemTemplate>
				<DataTemplate x:DataType="models:Game">
					<TextBlock Text="{Binding Title}"/>
				</DataTemplate>
			</ComboBox.ItemTemplate>
		</ComboBox>

		<TextBlock Text="Початок"/>
		<Grid ColumnDefinitions="*,8,*">
			<CalendarDatePicker Grid.Column="0"
								SelectedDate="{Binding StartDate}"
								HorizontalAlignment="Stretch"/>
			<TimePicker Grid.Column="2"
						SelectedTime="{Binding StartTime}"
						ClockIdentifier="24HourClock"
						HorizontalAlignment="Stretch"/>
		</Grid>



		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="Завершення (порожньо, якщо сесія триває)"
					   VerticalAlignment="Center"/>
			<Button Grid.Column="1"
					Content="Очистити"
					Command="{Binding ClearEndCommand}"
					Padding="8,2"
					FontSize="12"/>
		</Grid>
		<Grid ColumnDefinitions="*,8,*">
			<CalendarDatePicker Grid.Column="0"
								SelectedDate="{Binding EndDate}"
								HorizontalAlignment="Stretch"/>
			<TimePicker Grid.Column="2"
						SelectedTime="{Binding EndTime}"
						ClockIdentifier="24HourClock"
						HorizontalAlignment="Stretch"/>
		</Grid>

		<TextBlock Text="Нотатка"/>
		<TextBox Text="{Binding Note}"
				 PlaceholderText="Необов'язково..."
				 TextWrapping="Wrap"
				 MaxLength="500"/>

		<TextBlock Text="{Binding FormError}"
				   IsVisible="{Binding HasFormError}"
				   Foreground="#e05252"
				   FontSize="12"
				   TextWrapping="Wrap"/>

		<StackPanel Orientation="Horizontal" Spacing="8"
					HorizontalAlignment="Right" Margin="0,8,0,0">
			<Button Content="Скасувати" Command="{Binding CancelCommand}"/>
			<Button Content="Зберегти" Command="{Binding ConfirmCommand}"/>
		</StackPanel>

	</StackPanel>
</Window>